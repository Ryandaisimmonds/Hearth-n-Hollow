        description: "One mighty swing for \xD71.75 damage. Can crit."
        cooldownTurns: 3
        value: 1.75
      starterAttack: w_sweep
      starterSkill: w_cleave
      starterDash: roll
      branchNames:
      - Blade
      - Bulwark
      - Fury
      joinRoute: salt
      ultimate: w_ult
      joinText: They held the marsh boardwalk alone until you came.
    - id: 1
      name: Ranger
      emoji: "\U0001F3F9"
      role: Forager
      description: 'Knows the wilds by heart. Much wider golden gather zone. Lives on trail food: sandwiches are 50% stronger.'
      baseMaxHp: 12
      damageMult: 1
