      starterSkill: r_volley
      starterDash: roll
      branchNames:
      - Marksman
      - Wayfinder
      - Trickster
      joinRoute: meadow
      ultimate: r_ult
      joinText: They'd been tracking the meadow slimes, and they liked your bread.
    - id: 2
