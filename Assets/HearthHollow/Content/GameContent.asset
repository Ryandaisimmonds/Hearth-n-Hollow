    - id: 3
      name: Lamplighter
      emoji: "\U0001F3EE"
      role: Mage
      description: Keeper of the old lamps. Her light magic seeks out its targets. Restoring food suits her (heal on kill, coins); armour food does less for her.
      baseMaxHp: 14
      damageMult: 1
      gatherZoneMult: 1
      mealBuffMult: 1
