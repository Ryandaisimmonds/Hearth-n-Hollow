        description: "Two quick arrows for \xD70.75 damage each. Each can crit."
        cooldownTurns: 3
        value: 0.75
      starterAttack: r_shot
      starterSkill: r_volley
      starterDash: roll
      branchNames:
      - Marksman
      - Wayfinder
      - Trickster
      joinRoute: meadow
      ultimate: r_ult
      joinText: They'd been tracking the meadow slimes, and they liked your bread.
    - id: 2
      name: Cook
      emoji: "\U0001F373"
      role: Support
      description: 'Every meal tastes like home: every meal stat is a little stronger for the Cook.'
      baseMaxHp: 14
