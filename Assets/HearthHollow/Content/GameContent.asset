    classes:
    - id: 0
      name: Warden
      emoji: "\u2694\uFE0F"
      role: Bruiser
      description: A steady guardian of the campfire. Gets the most out of hearty food (health, armour); light, quick food does less for her.
      baseMaxHp: 14
      damageMult: 1
      gatherZoneMult: 1
      mealBuffMult: 1
      mealStatMults:
      - stat: 1
        value: 1.25
      - stat: 3
        value: 1.25
      - stat: 8
        value: 0.8
