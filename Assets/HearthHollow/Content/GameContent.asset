    classes:
    - id: 0
      name: Warden
      emoji: "\u2694\uFE0F"
      role: Bruiser
      description: 'A steady guardian of the campfire. Hits 15% harder. Loves the BBQ: grilled meals are 50% stronger.'
      baseMaxHp: 16
      damageMult: 1.15
      gatherZoneMult: 1
      mealBuffMult: 1
      favouriteStation: 1
      favouriteBonus: 0.5
      skill:
        kind: 0
        name: Cleave
