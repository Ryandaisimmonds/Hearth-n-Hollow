/* Hearth & Hollow — UI Toolkit runtime theme, "GUI-TheStone" art pass.
   Chunky painted stone panels with gold trim (Layer Lab GUI-TheStone) + point-filtered pixel monsters.
   Colour identity: warm amber hearth, cool green hollow, purple merchant.
   Only UI Toolkit-supported properties: flexbox, border-*, background-image + 9-slice (-unity-slice-*),
   -unity-background-scale-mode, -unity-background-image-tint-color, -unity-text-outline-*, text-shadow,
   transitions, translate/scale. (No box-shadow / grid / z-index.)
   9-slice values are SOURCE pixels; -unity-slice-scale shrinks the corners on screen.
   Emoji (food, fallbacks) need an emoji-capable font asset as a fallback in the PanelSettings Text Settings. */

/* Colours live in Theme.uss (loaded just before this sheet by GameBootstrap) — change a colour there and every screen follows. */

/* CONTENTS — one sheet per screen in UI/Styles/, imported below IN THIS ORDER.
   Order matters: when two rules tie, the later sheet wins (element-tints is last so a meal's
   element colour beats the card's normal colour). Add new rules to the sheet for that screen.
     base           root & layers, art primitives, panels & cards, buttons, header
     class-select   title / class select
     hearth         hearth
     bars           slider art
     bag            the bag grid and its slots
     overlays       pop-ups, floating numbers, gather, rest, run summary
     toasts         drag & toasts
     settings       Esc menu, settings, run log
     route-board    route board page, expedition panel, the feast
     dungeon-hud    real-time dungeon HUD, ladder, bag holding box, boss card, opening fall
     skills         skills tab (tree + loadout)
     scrollbars     slim amber scroll bars
     camp-event     camp-event pop-up
     camp           camp layout: tabs, cooking, workshop, right column, meal cards, tray
     kitchen        cooking v9: meal pantry + stove pop-up, spice rack, cook cards
     town           town (Hearth's Hollow) HUD
     element-tints  a meal's element colour on cards, tray slots, spice rack, route board
*/

@import url("Styles/base.uss");
@import url("Styles/class-select.uss");
@import url("Styles/hearth.uss");
@import url("Styles/bars.uss");
@import url("Styles/bag.uss");
@import url("Styles/overlays.uss");
@import url("Styles/toasts.uss");
@import url("Styles/settings.uss");
@import url("Styles/route-board.uss");
@import url("Styles/dungeon-hud.uss");
@import url("Styles/skills.uss");
@import url("Styles/scrollbars.uss");
@import url("Styles/camp-event.uss");
@import url("Styles/camp.uss");
@import url("Styles/kitchen.uss");
@import url("Styles/town.uss");
@import url("Styles/element-tints.uss");
