/* Hearth & Hollow — toasts. Part of HearthHollow.uss (imported in order; see that file). */

/* ───────────────────────── drag & toasts ───────────────────────── */
.drag-ghost {
    position: absolute;
    width: 60px; height: 60px;
    font-size: 30px;
    -unity-text-align: middle-center;
    background-image: url("project://database/Assets/ThirdParty/GUI-TheStone/Components/Frame/ItemFrama02_Demo_f.png#ItemFrama02_Demo_f");
    -unity-background-scale-mode: scale-to-fit;
}

.toast {
    background-color: rgba(30, 24, 16, 0.95);
    color: var(--hh-text);
    border-radius: 14px;
    border-width: 2px;
    border-color: #8a6a2a;
    padding: 6px 16px;
    margin: 3px;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(0, 0, 0, 0.5);
    transition-property: opacity, translate;
    transition-duration: 0.25s;
}
.toast--enter { opacity: 0; translate: 0 -12px; }
.toast--leave { opacity: 0; translate: 0 -8px; }
.toast--loot { border-color: #6fae5c; }
.toast--warn { border-color: var(--hh-bad); background-color: rgba(58, 36, 32, 0.95); }
.toast--level { border-color: var(--hh-gold); background-color: rgba(74, 50, 22, 0.95); color: var(--hh-cream); font-size: 16px; }
.toast--synergy { border-color: var(--hh-gold); color: var(--hh-gold-soft); }
.toast--coins { color: var(--hh-gold-soft); }
.toast--xp { color: var(--hh-sky); }

.panel > .panel__title { margin-bottom: 6px; }
