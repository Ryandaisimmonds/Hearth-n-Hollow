      - smithy
      - workshop
      giveStarterFood: 0
      giveFirstBoots: 1
      giveCoins: 0
    - name: The Pit
      reachedBy: 3
      toast: "\U0001F573\uFE0F The floor gives way! You land in a forgotten cache\u2026"
      opens: []
      giveStarterFood: 0
      giveFirstBoots: 0
      giveCoins: 0
    - name: Hollow
      reachedBy: 4
      toast: "\U0001F3D8\uFE0F With what you found below, the camp starts to grow into a proper little town."
      opens:
      - town
      giveStarterFood: 0
      giveFirstBoots: 0
      giveCoins: 50
